{
	"name": "backend",
	"private": true,
	"packageManager": "npm@11.6.0",
	"type": "module",
	"engines": {
		"node": "^22.18.0 || >=24.11.0"
	},
	"scripts": {
		"build": "npm run prisma:generate && tsdown",
		"test:authorization": "tsx --test src/authorization/authorization.spec.ts",
		"prisma:generate": "prisma generate",
		"migrate": "prisma migrate dev",
		"migrate:deploy": "prisma migrate deploy",
		"migration:status": "prisma migrate status",
		"deploy": "npm run build",
		"deploy:migrations": "npm run migrate:deploy",
		"dev": "npm run prisma:generate && tsx watch src/main.ts",
		"start": "node dist/server.mjs"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1156.0",
		"@nestjs/common": "^11.1.17",
		"@nestjs/core": "^11.1.17",
		"@nestjs/jwt": "^12.0.2",
		"@nestjs/mapped-types": "*",
		"@nestjs/platform-express": "^11.1.17",
		"@prisma/adapter-pg": "7.10.1",
		"@prisma/client": "7.10.1",
		"bcrypt": "^6.0.0",
		"bcryptjs": "^3.0.3",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"cookie-parser": "^1.4.7",
		"dotenv": "^18.0.1",
		"pg": "^8.16.3",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"temporal-polyfill": "^1.0.4"
	},
	"devDependencies": {
		"@types/cookie-parser": "^1.4.10",
		"@types/node": "^25.6.2",
		"prisma": "7.10.1",
		"tsdown": "^0.22.14",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	}
}
