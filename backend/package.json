{
  "name": "backend",
  "private": true,
  "packageManager": "npm@11.6.0",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build": "tsdown",
    "test:authorization": "tsx --test src/authorization/authorization.spec.ts",
    "composer:deploy": "prisma deploy module.ts",
    "composer:dev": "prisma dev module.ts",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:verify": "prisma db verify",
    "deploy": "npm run build && npm run composer:deploy",
    "dev": "tsx watch src/main.ts",
    "dev:composer": "npm run build && npm run composer:dev",
    "migrate": "prisma db migrate",
    "migration:plan": "prisma migration plan",
    "migration:show": "prisma migration show",
    "migration:status": "prisma migration status",
    "start": "node dist/server.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^11.1.17",
    "@prisma/composer": "0.20.0",
    "@prisma/composer-prisma-cloud": "0.20.0",
    "@prisma/orm-postgres": "8.0.0-rc.11",
    "alchemy": "2.0.0-beta.74",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "temporal-polyfill": "^1.0.4"
  },
  "devDependencies": {
    "@prisma/dev": "0.25.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^25.6.2",
    "prisma": "8.0.0-rc.15",
    "tsdown": "^0.22.14",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "effect": "4.0.0-rc.112"
  }
}
